# S1 runtime configuration for the disposable, containerized bridge.
# Do not use this file to configure a host-native or persistent service.

HOST=127.0.0.1
PORT=8765
# Optional for a direct local client; the supplied Compose runtime does not set it.
# MCP_TOKEN=change-me
BODY_LIMIT=2mb

# The only runtime workspace is the disposable repository bind mount.
WORKSPACE_ROOTS=/workspace/repo
DEFAULT_WORKSPACE=/workspace/repo
ALLOW_TOOL_ROOT_REGISTRATION=false
INCLUDE_COMMON_WORKSPACE_ROOTS=false
INCLUDE_SCRATCH_ROOT=false

# State and process logs are bounded container-owned tmpfs paths.
BRIDGE_HARDENED=true
BRIDGE_STATE_DIR=/state
BRIDGE_SCRATCH_DIR=/state/scratch
COMMAND_TIMEOUT_MS=120000
MAX_STDOUT_CHARS=24000
MAX_STDERR_CHARS=12000
MAX_CONCURRENT_TOOLS=8
MAX_PROCESS_LOG_BYTES=10000000
PROCESS_RETENTION_DAYS=14
MAX_PROCESS_RECORDS=500

# The catalog is fail-closed. Removing a name is allowed; adding an unknown or
# later/upstream capability is rejected during startup.
ENABLED_TOOLS=bridge_instructions,workspace_list,workspace_open,workspace_tree,workspace_snapshot,read_file,search_text,write_file,apply_patch,edit_file,git_status,git_diff,git_log,git_branch_create,git_branch_switch,git_stage,git_commit,project_test,project_lint,project_typecheck,project_build,repo_shell,process_start,process_list,process_logs,process_stop,health

# S1 has no destructive confirmation path.
DESTRUCTIVE_APPROVAL_MODE=deny
DESTRUCTIVE_AUDIT_FAIL_CLOSED=true

# These stay false/empty in the S1 container.
ALLOW_PRIVATE_NETWORK=false
ALLOW_CROSS_ORIGIN_REDIRECTS=false
TOOL_ENV_INHERIT_SECRETS=false
# BRIDGE_DENY_PATHS=/another/protected/path

# OpenAI tunnel, GitHub, Codex, SSH, NAS, Docker, browser, Office, and native
# desktop credentials/configuration are intentionally absent from S1.
