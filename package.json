{
  "name": "chatgpt-sol-local-bridge",
  "version": "1.0.0-s1",
  "description": "Pinned S1 MCP bridge foundation for disposable repository workspaces inside a hardened container.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingrath/chatgpt-sol-local-bridge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "doctor": "node src/doctor.js",
    "smoke": "node scripts/smoke.mjs",
    "s3:workspace-proof": "node scripts/s3-workspace-proof.mjs",
    "s3:transport-proof": "node scripts/s3-transport-proof.mjs",
    "s4:real-tunnel-proof": "node scripts/s4-real-tunnel-proof.mjs",
    "s5:runtime": "node scripts/s5-runtime.mjs",
    "s5:runtime-proof": "node scripts/s5-runtime-proof.mjs",
    "s5:local-workflow-proof": "node scripts/s5-local-workflow-proof.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "docx": "9.5.1",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "ipaddr.js": "2.5.0",
    "mammoth": "1.10.0",
    "undici": "6.28.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "files": [
    "src",
    "scripts",
    "docs",
    "launchd",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "chatgpt",
    "mcp",
    "secure-mcp-tunnel",
    "codex",
    "automation",
    "cross-platform"
  ]
}
